{
  "expo": {
    "name": "Majlis Founder OS",
    "slug": "majlis-app",
    "owner": "mufidasaids-team",
    "scheme": "majlisfounderos",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-av",
        {
          "microphonePermission": "Allow Majlis Founder OS to access your microphone to record voice messages."
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3dac72a8-b799-45de-b3fd-209fe9e2876a"
    },
    "extra": {
      "eas": {
        "projectId": "3dac72a8-b799-45de-b3fd-209fe9e2876a"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.majlisacademy.founderos"
    },
    "android": {
      "package": "com.majlisacademy.founderos"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./public/favicon.png"
    },
    "experiments": {
      "baseUrl": "/Majlis-Admin"
    }
  }
}
