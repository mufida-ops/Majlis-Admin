# AI Router -- text generation adapter (see lib/ai-router.ts).
# Without this set, the app runs on a deterministic mock adapter so the full
# pipeline (grounding engine -> router -> validation -> UI) is testable
# without a live key. Set this to switch to real generation.
ANTHROPIC_API_KEY=

# Persistence (see lib/db.ts). Without these set, lesson sessions are kept
# in an in-memory store that resets on every server restart -- fine for
# local development, not for anything you want to keep. Create a Supabase
# project, run supabase/schema.sql against it, and fill these in to persist
# real data.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
